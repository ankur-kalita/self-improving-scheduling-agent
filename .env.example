# Any OpenAI-compatible endpoint works. Defaults target Google Gemini's
# OpenAI-compatible API (free tier key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional overrides
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=            # takes precedence over GEMINI_API_KEY / OPENAI_API_KEY
# Free-tier quotas are per model, so each role defaults to a different one.
# AGENT_MODEL=gemini-3.5-flash-lite
# SIM_MODEL=gemma-4-26b-a4b-it
# JUDGE_MODEL=gemini-3.1-flash-lite
# IMPROVER_MODEL=gemini-3.1-flash-lite
# LLM_RPM=10               # client-side requests/minute cap per model
# EVAL_CONCURRENCY=3
