# Any OpenAI-compatible endpoint works. Defaults target Google Gemini's
# OpenAI-compatible API (free tier key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional overrides
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=            # takes precedence over GEMINI_API_KEY / OPENAI_API_KEY
# AGENT_MODEL=gemini-2.5-flash
# SIM_MODEL=gemini-2.5-flash-lite
# JUDGE_MODEL=gemini-2.5-flash
# IMPROVER_MODEL=gemini-2.5-flash
# LLM_RPM=10               # client-side requests/minute cap per model
# EVAL_CONCURRENCY=3
